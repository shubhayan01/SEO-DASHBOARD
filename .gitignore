node_modules/
.env
.env.*
!.env.example
data/*.json
# Ship demo data with the deploy so free-tier hosts (no persistent disk) boot
# with clients + logins already present. Runtime edits still won't persist on
# free tier, but this seed data always will.
!data/clients.json
!data/users.json
data/*.csv
data/.chrome-profile/
!data/.gitkeep

# Google service-account credentials — never commit. Grants read access to
# every connected property. Provide via GOOGLE_SERVICE_ACCOUNT_JSON in prod.
*service-account*.json
spatial-tempo-*.json

# Local Claude Code settings (machine-specific)
.claude/

# Client-confidential documents — not application code, keep out of the repo
*.pdf
eMod Projects*.csv
