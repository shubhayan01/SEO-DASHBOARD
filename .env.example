# Copy to .env for local dev. In production (Render/Railway) set these in the
# host's Environment dashboard instead — do NOT commit real values.

# ---- Server ----
# Render/Railway inject PORT automatically; leave unset in production.
PORT=5000
NODE_ENV=production

# Persistent storage. Point this at a mounted disk in production (e.g. /data)
# so users.json / clients.json survive redeploys. Defaults to ./data locally.
DATA_DIR=/data

# Secret used to sign login tokens. MUST be 32+ random chars in production.
# Generate one with:  node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
JWT_SECRET=change-me-to-a-long-random-string

# ---- Daily auto-refresh ----
# Re-audits every client once a day and persists the score. On by default.
AUTO_REFRESH=true
AUTO_REFRESH_HOUR=3            # local hour (0-23) to run the daily batch
AUTO_REFRESH_STAGGER_MS=8000  # gap between clients so PSI/Chrome isn't hammered

# ---- Default login (created on first run only) ----
ADMIN_EMAIL=admin@agency.com
ADMIN_PASSWORD=change-me-strong-password

# ---- Groq API (AI SEO analysis summary) ----
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ---- Google PageSpeed + CrUX ----
# Recommended in production: the audit uses this HTTP API instead of local
# Chrome/Lighthouse, which is not available on Render/Railway's default runtime.
GOOGLE_PSI_KEY=

# ---- Google service account (Search Console + GA4 + Business Profile) ----
# In production paste the whole service-account JSON on ONE line here:
GOOGLE_SERVICE_ACCOUNT_JSON=
# Local dev alternative — a path to the JSON file (never commit the file):
# GOOGLE_SERVICE_ACCOUNT_FILE=./service-account.json
# Optional Workspace user to impersonate (domain-wide delegation):
# GOOGLE_IMPERSONATE_SUBJECT=owner@yourdomain.com

# ---- BrightLocal (local SEO: local rankings, citations/NAP, GBP audit) ----
# One API key for the whole agency. Find it in BrightLocal > Account > API, or
# request it from BrightLocal support. A new key starts in trial mode with 250
# free credits; reading existing reports (what this dashboard does) costs none.
# Once set, map each client to its BrightLocal location in the admin UI
# (client report > "Connect data" > BrightLocal location ID).
BRIGHTLOCAL_API_KEY=
